# ============================================================================
# ALRIS — Configuração de Telefonia WebRTC (Click-to-Call), Backend & Supabase
# Quando as credenciais abaixo estiverem vazias, o Modo Mock/Sandbox Local é
# ativado automaticamente para testes completos de microfone, DTMF e histórico.
# ============================================================================

PORT=8080

# Provedor de Voz WebRTC (Twilio Voice / Telnyx / SIP Gateway)
VOICE_ACCOUNT_SID=
VOICE_API_KEY=
VOICE_API_SECRET=
VOICE_APP_SID=
VOICE_CALLER_ID=+551140001234
WEBHOOK_BASE_URL=https://api.seu-dominio-alris.com.br

# Banco de Dados Supabase (PostgreSQL + RLS Multi-Tenant)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP Opcional para Envio Real de E-mails de Confirmação
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
