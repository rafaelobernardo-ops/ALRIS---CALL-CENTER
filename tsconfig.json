{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": []
  },
  "include": [
    "types/**/*.d.ts",
    "src/**/*.ts",
    "js/**/*.js",
    "server.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "backend"
  ]
}
